{
  "name": "respira-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UK Respiratory Health Evidence Atlas \u2014 place-based evidence for respiratory health research and public decisions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:prepare": "node scripts/prepare-data/index.mjs",
    "data:validate": "node scripts/validate-data/index.mjs",
    "smoke": "node tests/smoke/run-smoke.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@amcharts/amcharts5": "5.21.2",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "3.1.1",
    "lucide-react": "0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@types/d3-geo": "3.1.0",
    "@types/node": "22.13.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "26.0.0",
    "playwright": "1.50.1",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.1.1",
    "vitest": "3.0.6",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=20"
  }
}
