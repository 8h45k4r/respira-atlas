# Cloudflare Pages response headers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  # No runtime backend and no secrets: everything the page needs is served from
  # this origin, except the webfonts.
  #
  # static.cloudflareinsights.com is allowed because Cloudflare injects its Web
  # Analytics beacon into every response when analytics is enabled on the zone.
  # It is cookieless and collects no personal data. Blocking it did not disable
  # analytics, it only produced a CSP error on every page load. To remove it
  # properly, turn Web Analytics off for the zone and drop these two entries.
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; form-action 'none'

# Hashed build assets are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data files are versioned by the manifest; revalidate so a redeploy is picked up.
/data/*
  Cache-Control: public, max-age=3600, must-revalidate
